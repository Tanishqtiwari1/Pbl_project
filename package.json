{
  "name": "cardioguard-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "cd Backend && PYTHONPATH=. python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.28",
    "vite": "^7.1.7"
  }
}
